# Copy to .env and fill in. These are local-development placeholders, never real
# secrets: SC-7 forbids committing a real value. `src/config/env.ts` is the
# authority on which variables are required and how each is validated.

# Server
PORT=3000
NODE_ENV=development

# Database
# Local development. Automated tests use their own instance on 5433
# (persistence-conventions.md PC-1).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/customer_portal

# JWT
# Generate per environment, e.g. `openssl rand -base64 32`. Never reuse the two.
JWT_ACCESS_SECRET=replace-me-generate-a-random-32-byte-secret
JWT_REFRESH_SECRET=replace-me-generate-a-different-random-32-byte-secret
# Token lifetimes are decided in security-conventions.md SC-3.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS
# Explicit allow-list, comma-separated. A wildcard with credentials is forbidden
# (security-conventions.md SC-5).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info

# Proxy topology — hop count, never blanket true (security-conventions.md SC-5).
# 0 locally and in CI: nothing sits in front of the process.
# 1 in production: exactly one reverse proxy. This number is what makes the
# per-IP rate limit real; adding a CDN in front makes it 2, in the same commit.
TRUST_PROXY=0
